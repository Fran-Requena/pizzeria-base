# ==============================================================================
# VARIABLES DE ENTORNO (PLANTILLA DIDÁCTICA)
# Copia este archivo como '.env' en la raíz antes de arrancar Docker:
# cp .env.example .env
# ==============================================================================

# 1. ENTORNO DE EJECUCIÓN
NODE_ENV=production

# 2. CONECTIVIDAD CLOUDFLARE ZERO TRUST (TUNNEL)
# Pega aquí el token asignado por el profesor para tu subdominio (ej: daw-01)
CLOUDFLARE_TUNNEL_TOKEN=

# 3. PUERTOS INTERNOS / EXPOSICIÓN LOCAL (OPCIONAL)
HTTP_PORT=80
QR_PORT=8081
DBGATE_PORT=8082

# 4. BASE DE DATOS POSTGRESQL
# Opción A (Local / Homelab con contenedor Docker):
# DB_HOST=db
# Opción B (Cloud en AWS con Base de Datos Gestionada AWS RDS):
# DB_HOST=pizzeria-db.c123456789.us-east-1.rds.amazonaws.com
DB_HOST=db
DB_PORT=5432
DB_NAME=pizzeria_db
DB_USER=pizzeria_user
# Clave de laboratorio, solo para aprendizaje (en produccion real se elegiria otra).
# Con RDS debe ser la misma que la contrasena maestra de AWS. Los compose de produccion
# no arrancan si la borras. En desarrollo local (docker-compose.yml) si queda vacia se usa
# una clave de pruebas.
DB_PASSWORD=pizzeria_pass_2026!
# Cifrado SSL con la base de datos. Con RDS (DB_HOST distinto de db/localhost) se activa solo;
# pon true para forzarlo en otros casos. Vacia = comportamiento automatico.
DB_SSL=

# 4. BACKEND API REST (NODE.JS / EXPRESS)
BACKEND_PORT=3000
CORS_ORIGIN=*

# 5. PASARELA DE PAGOS STRIPE (OPCIONAL / DIDÁCTICO)
# Si se dejan vacías, la pizzería funcionará normalmente con pagos en efectivo y datáfono.
# En modo desarrollo o túnel Cloudflare, permite recibir webhooks en /api/pagos/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Direccion publica de tu pizzeria (la de tu tunel), sin barra final. Ej: https://daw-XX.tudominio.org
FRONTEND_URL=

# 6. RECONCILIACION DE PAGOS CON STRIPE (OPCIONAL; solo actua si Stripe esta configurado)
# El servidor revisa cada pocos minutos los pedidos pagados cuyo aviso (webhook) no llego.
# Vacias = valores por defecto.
# RECONCILIACION_MINUTOS: cada cuantos minutos se revisa (por defecto 2; 0 lo desactiva).
RECONCILIACION_MINUTOS=
# RECONCILIACION_ESPERA_SEGUNDOS: espera minima entre dos revisiones pedidas a mano (por defecto 30).
RECONCILIACION_ESPERA_SEGUNDOS=
